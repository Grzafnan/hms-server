// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id          Int      @id @default(autoincrement())
  fullName    String   @map("full_name") @db.VarChar(100)
  dob         DateTime @db.Date
  gender      String   @db.VarChar(10)
  phone       String?  @db.VarChar(20)
  email       String?  @unique @db.VarChar(100)
  address     String?  @db.Text
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  appointments     Appointment[]
  bills           Bill[]
  medicalRecords  MedicalRecord[]
  prescriptions   Prescription[]
  labTests        LabTest[]
  radiologyScans  Radiology[]
  admissions      Admission[]
  
  @@map("patients")
}

model Staff {
  id         Int      @id @default(autoincrement())
  fullName   String   @map("full_name") @db.VarChar(100)
  role       String   @db.VarChar(50)
  department String?  @db.VarChar(100)
  email      String?  @unique @db.VarChar(100)
  phone      String?  @db.VarChar(20)
  salary     Decimal? @db.Decimal(10, 2)
  joinDate   DateTime? @map("join_date") @db.Date
  status     String   @default("Active") @db.VarChar(20)
  isDeleted  Boolean  @default(false) @map("is_deleted")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  
  user           User?
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  
  @@map("staff")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         String   @db.VarChar(50)
  staffId      Int?     @map("staff_id") @unique
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  staff Staff? @relation(fields: [staffId], references: [id])
  
  @@map("users")
}

model Appointment {
  id              Int      @id @default(autoincrement())
  patientId       Int      @map("patient_id")
  doctorId        Int      @map("doctor_id")
  appointmentDate DateTime @map("appointment_date")
  status          String   @default("Scheduled") @db.VarChar(20)
  notes           String?  @db.Text
  isDeleted       Boolean  @default(false) @map("is_deleted")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Staff   @relation(fields: [doctorId], references: [id])
  
  @@map("appointments")
}

model Bill {
  id          Int      @id @default(autoincrement())
  patientId   Int      @map("patient_id")
  totalAmount Decimal  @map("total_amount") @db.Decimal(10, 2)
  status      String   @default("Unpaid") @db.VarChar(20)
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  patient  Patient   @relation(fields: [patientId], references: [id])
  payments Payment[]
  
  @@map("bills")
}

model Payment {
  id            Int      @id @default(autoincrement())
  billId        Int      @map("bill_id")
  amount        Decimal  @db.Decimal(10, 2)
  paymentDate   DateTime @default(now()) @map("payment_date")
  paymentMethod String   @map("payment_method") @db.VarChar(50)
  isDeleted     Boolean  @default(false) @map("is_deleted")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  bill Bill @relation(fields: [billId], references: [id])
  
  @@map("payments")
}

model Inventory {
  id         Int      @id @default(autoincrement())
  itemName   String   @map("item_name") @db.VarChar(100)
  category   String   @db.VarChar(50)
  quantity   Int      @default(0)
  unitPrice  Decimal? @map("unit_price") @db.Decimal(10, 2)
  expiryDate DateTime? @map("expiry_date") @db.Date
  isDeleted  Boolean  @default(false) @map("is_deleted")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  
  @@map("inventory")
}

model Prescription {
  id             Int      @id @default(autoincrement())
  patientId      Int      @map("patient_id")
  doctorId       Int      @map("doctor_id")
  prescribedDate DateTime @default(now()) @map("prescribed_date")
  isDeleted      Boolean  @default(false) @map("is_deleted")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  
  patient           Patient            @relation(fields: [patientId], references: [id])
  doctor            Staff              @relation(fields: [doctorId], references: [id])
  prescriptionItems PrescriptionItem[]
  
  @@map("prescriptions")
}

model PrescriptionItem {
  id             Int    @id @default(autoincrement())
  prescriptionId Int    @map("prescription_id")
  medicineName   String @map("medicine_name") @db.VarChar(100)
  dosage         String? @db.VarChar(50)
  duration       String? @db.VarChar(50)
  instructions   String? @db.Text
  isDeleted      Boolean @default(false) @map("is_deleted")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  
  prescription Prescription @relation(fields: [prescriptionId], references: [id])
  
  @@map("prescription_items")
}

model LabTest {
  id        Int      @id @default(autoincrement())
  patientId Int      @map("patient_id")
  testName  String   @map("test_name") @db.VarChar(100)
  testDate  DateTime @default(now()) @map("test_date")
  result    String?  @db.Text
  status    String   @default("Pending") @db.VarChar(20)
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  patient Patient @relation(fields: [patientId], references: [id])
  
  @@map("lab_tests")
}

model Radiology {
  id        Int      @id @default(autoincrement())
  patientId Int      @map("patient_id")
  scanType  String   @map("scan_type") @db.VarChar(100)
  scanDate  DateTime @default(now()) @map("scan_date")
  result    String?  @db.Text
  status    String   @default("Pending") @db.VarChar(20)
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  patient Patient @relation(fields: [patientId], references: [id])
  
  @@map("radiology")
}

model Bed {
  id        Int    @id @default(autoincrement())
  bedNumber String @unique @map("bed_number") @db.VarChar(20)
  ward      String? @db.VarChar(50)
  type      String @db.VarChar(50)
  status    String @default("Available") @db.VarChar(20)
  isDeleted Boolean @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  admissions Admission[]
  
  @@map("beds")
}

model Admission {
  id            Int       @id @default(autoincrement())
  patientId     Int       @map("patient_id")
  bedId         Int?      @map("bed_id")
  admitDate     DateTime  @default(now()) @map("admit_date")
  dischargeDate DateTime? @map("discharge_date")
  notes         String?   @db.Text
  isDeleted     Boolean   @default(false) @map("is_deleted")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  patient Patient @relation(fields: [patientId], references: [id])
  bed     Bed?    @relation(fields: [bedId], references: [id])
  
  @@map("admissions")
}

model MedicalRecord {
  id         Int      @id @default(autoincrement())
  patientId  Int      @map("patient_id")
  doctorId   Int      @map("doctor_id")
  diagnosis  String?  @db.Text
  treatment  String?  @db.Text
  recordDate DateTime @default(now()) @map("record_date")
  isDeleted  Boolean  @default(false) @map("is_deleted")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  
  patient Patient @relation(fields: [patientId], references: [id])
  doctor  Staff   @relation(fields: [doctorId], references: [id])
  
  @@map("medical_records")
}